  (text "Carrier board: Arduino Pro Mini on top, CC1101 11-pin module on the bottom." (exclude_from_sim no) (at 25.4 139.7 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "8f52ef44-d919-4acc-9767-93c444533873"))
  (text "Use a 3.3 V / 8 MHz Pro Mini: the CC1101 is not 5 V tolerant." (exclude_from_sim no) (at 25.4 144.78 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "58e175d2-ccaf-4169-a012-96e37db26570"))
  (text "Power: 1S LiPo / 18650 (or 2xAA) straight on VCC via J2 -> Q1 (reverse-polarity P-FET). Measure sleep current in the battery lead at J2." (exclude_from_sim no) (at 25.4 149.86 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "7b367c9f-b3fe-4258-960d-a9c9c6963b9f"))
  (text "No regulator by user choice: a full Li-ion cell is 4.2 V, above the CC1101 3.6 V rating. Use protected cells (nothing here stops deep discharge)." (exclude_from_sim no) (at 25.4 154.94 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "8f9cfdd6-d57d-4087-bb4b-484654522481"))
  (text "Remove the Pro Mini power LED and regulator; unplug the battery while programming (FTDI adapter set to 3.3 V)." (exclude_from_sim no) (at 25.4 160.02 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "680a7c13-071d-4827-b225-07772c987545"))
  (text "C1 22uF bulk for TX bursts. R1 4.7k = DS18B20 pull-up (DS18B20 nodes only). R2 330R series protection on D3." (exclude_from_sim no) (at 25.4 165.1 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "15457b80-9d03-488c-b4b0-0f93c0a4f56d"))
  (text "C2 100nF = reed/button debounce, leave OFF for DS18B20 (1-Wire timing)." (exclude_from_sim no) (at 25.4 170.18 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "2c131705-6b36-461e-b304-9c52a14e8fa7"))
  (text "J1 sensor header: RAW VCC D3 SCL SDA GND. GDO2 is not connected so D3 stays free for muhradio sensors." (exclude_from_sim no) (at 25.4 175.26 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "4c1542dd-0ae5-4b7e-877a-a752811a545a"))
  (text "A4/A5 holes match the SparkFun layout; on other clones jumper A4/A5 to J1 SDA/SCL." (exclude_from_sim no) (at 25.4 180.34 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "409cbab5-6578-4769-9cfa-989f74041d4e"))
