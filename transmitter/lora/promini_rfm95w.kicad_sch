  (text "Carrier board: Arduino Pro Mini on top, RFM95W LoRa module on the bottom (muhradio LoRa node)." (exclude_from_sim no) (at 25.4 139.7 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "7ca0eeb5-316e-4656-89d1-753f6b0bd716"))
  (text "Use a 3.3 V / 8 MHz Pro Mini: the RFM95W is not 5 V tolerant (1.8-3.7 V)." (exclude_from_sim no) (at 25.4 144.78 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "dd07fb22-36cb-465f-a19b-c607b17646ec"))
  (text "Power: 1S LiPo / 18650 (or 2xAA) straight on VCC via J2 -> Q1 (reverse-polarity P-FET). Measure sleep current in the battery lead at J2." (exclude_from_sim no) (at 25.4 149.86 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "52d44025-8251-4f01-9ec3-62b179f958bc"))
  (text "No regulator by user choice: a full Li-ion cell is 4.2 V, above the CC1101 3.6 V rating. Use protected cells (nothing here stops deep discharge)." (exclude_from_sim no) (at 25.4 154.94 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "f36e5908-ba56-426a-b1b3-c111718273fa"))
  (text "Remove the Pro Mini power LED and regulator; unplug the battery while programming (FTDI adapter set to 3.3 V)." (exclude_from_sim no) (at 25.4 160.02 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "c87814ba-9195-4d6a-a505-f53eb0e7af60"))
  (text "C1 22uF bulk for TX bursts. R1 4.7k = DS18B20 pull-up (DS18B20 nodes only). R2 330R series protection on D3." (exclude_from_sim no) (at 25.4 165.1 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "6c929f56-a5a0-4d5e-8afe-db2c6385f34f"))
  (text "C2 100nF = reed/button debounce, leave OFF for DS18B20 (1-Wire timing)." (exclude_from_sim no) (at 25.4 170.18 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "5c9ad5ed-247f-4dbb-bef9-73331db47c05"))
  (text "J1 sensor header: RAW VCC D3 SCL SDA GND. Radio: D13 SCK, D12 MISO, D11 MOSI, D10 NSS, D9 RST, D2 DIO0 (muhradio LoRa pinout)." (exclude_from_sim no) (at 25.4 175.26 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "8769a52e-677f-498d-990c-4771a1b2d605"))
  (text "A4/A5 holes match the SparkFun layout; on other clones jumper A4/A5 to J1 SDA/SCL." (exclude_from_sim no) (at 25.4 180.34 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "b78cf495-fc8c-407d-9386-a146b1220c37"))
  (text "FTDI row pads are plated but unconnected." (exclude_from_sim no) (at 25.4 185.42 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "5e795d4d-f33d-47d7-8649-4bfd7847bfb0"))
