  (text "muhradio receiver (env esp32-s3-zero-cc1101 / -bresser): SCK=GP9 MISO=GP7 MOSI=GP8 SS=GP6 GDO0=GP2." (exclude_from_sim no) (at 25.4 139.7 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "4f2f23f3-d8f3-4359-8924-acf00e5a85de"))
  (text "GDO2 is wired to GP4 as a spare (firmware does not use it yet)." (exclude_from_sim no) (at 25.4 144.78 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "f80354b1-5a05-42cd-98a1-8735486e60cf"))
  (text "Radio 3.3 V comes from the S3-Zero's 3V3 pin through FB1 + C1/C2 to keep WiFi TX noise off the receiver." (exclude_from_sim no) (at 25.4 149.86 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "667f2aec-a462-4eea-ad1d-c3432dd65e47"))
  (text "Board is powered by the S3-Zero's USB-C. ANT pad is a plated hole for an 86 mm wire (quarter wave at 868 MHz)." (exclude_from_sim no) (at 25.4 154.94 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "399ee23a-6fe1-4988-b878-ccd86cab0634"))
  (text "Both modules on the top side; the CC1101 sits about 40 mm from the S3-Zero's 2.4 GHz antenna." (exclude_from_sim no) (at 25.4 160.02 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "0f167e48-2f58-4621-b667-cb0f3af1b8fa"))
  (sheet_instances (path "/" (page "1")))
